<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lessons | Northwest Piano</title>
  <meta name="description" content="Private, in-home piano lessons for all ages. Learn any style - classical, rock, jazz, pop. $70 for 50 minutes. First lesson is free.">
  <meta property="og:title" content="Lessons | Northwest Piano">
  <meta property="og:description" content="Private, in-home piano lessons for all ages. Learn any style — classical, rock, jazz, pop. $70 for 50 minutes. First lesson is free.">
  <meta property="og:image" content="https://nwpianolessons.com/images/og-image.png">
  <meta property="og:url" content="https://nwpianolessons.com/lessons">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Northwest Piano">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Lessons | Northwest Piano">
  <meta name="twitter:description" content="Private, in-home piano lessons for all ages. Learn any style — classical, rock, jazz, pop. $70 for 50 minutes. First lesson is free.">
  <meta name="twitter:image" content="https://nwpianolessons.com/images/og-image.png">
  <link rel="canonical" href="https://nwpianolessons.com/lessons">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;1,400&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="images/favicon.svg">
  <link rel="apple-touch-icon" href="images/apple-touch-icon.png">
  <link rel="stylesheet" href="css/style.css">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Private Piano Lessons",
    "provider": {
      "@id": "https://nwpianolessons.com/#business",
      "name": "Northwest Piano"
    },
    "description": "Private, in-home piano lessons for all ages. Learn any style — classical, rock, jazz, pop. Custom lesson plans tailored to each student.",
    "serviceType": "Music Education",
    "areaServed": {
      "@type": "Place",
      "name": "Northwest Suburbs of Chicago, Illinois"
    },
    "offers": {
      "@type": "Offer",
      "price": "70",
      "priceCurrency": "USD",
      "description": "50-minute private lesson. First lesson is free.",
      "eligibleRegion": {
        "@type": "Place",
        "name": "Northwest Suburbs of Chicago, IL"
      }
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Lesson Types",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Piano Lessons",
            "description": "Private in-home piano lessons for all ages and skill levels. Classical, rock, jazz, pop, and more."
          }
        }
      ]
    }
  }
  </script>
</head>
<body>

  <header class="site-header">
    <div class="container">
      <a href="index.html" class="logo">
        <img src="images/logo-banner.png" alt="NW Piano" height="36">
      </a>
      <button class="nav-toggle" aria-label="Toggle navigation"><span></span></button>
      <nav class="main-nav">
        <ul>
          <li><a href="index.html">home</a></li>
          <li><a href="lessons.html" class="active">lessons</a></li>
          <li><a href="faq.html">faq</a></li>
          <li><a href="locations.html">locations</a></li>
          <li><a href="about.html">about</a></li>
          <li><a href="contact.html">contact</a></li>
        </ul>
      </nav>
    </div>
  </header>
  <div class="nav-overlay"></div>

  <section class="page-header">
    <div class="container">
      <div class="split reveal">
        <div class="split__text">
          <span class="section-label">What to Expect</span>
          <h1 class="section-title">Lessons</h1>
          <p class="section-desc">Sessions are 50 minutes and take place in the comfort of your home. Your first session is free, with no commitment. With flexible scheduling, we can find a time that works well for you.</p>
          <a href="contact.html" class="btn btn--gold">Schedule a Free Lesson</a>
        </div>
        <div class="split__media">
          <img loading="lazy" src="images/piano-sohmer.jpg" alt="Sohmer & New York piano detail">
        </div>
      </div>
    </div>
  </section>

  <section class="section--flush">
    <div class="container">
      <div class="features reveal">
        <div class="feature">
          <div class="feature__icon">&#9835;</div>
          <div class="feature__title">Learn Any Style</div>
          <p class="feature__desc">Lessons tailored to your goals, interests, and experience. Whether you love classical, jazz, rock, or pop, we'll focus on the music that keeps you inspired.</p>
        </div>
        <div class="feature">
          <div class="feature__icon">&#8962;</div>
          <div class="feature__title">In-Home</div>
          <p class="feature__desc">Quality music lessons without leaving home.</p>
        </div>
        <div class="feature">
          <div class="feature__icon">&#9734;</div>
          <div class="feature__title">Private, 1-on-1</div>
          <p class="feature__desc">Personalized instruction tailored to your pace, goals, and learning style.</p>
        </div>
        <div class="feature">
          <div class="feature__icon">&#127760;</div>
          <div class="feature__title">All Ages</div>
          <p class="feature__desc">Children, teens, &amp; adults from beginner to college level.</p>
        </div>
        <div class="feature">
          <div class="feature__icon">&#9998;</div>
          <div class="feature__title">Custom Plans</div>
          <p class="feature__desc">Lessons tailored to each student's goals, interests, and needs.</p>
        </div>
        <div class="feature">
          <div class="feature__icon">&#8986;</div>
          <div class="feature__title">$70 / 50 Min</div>
          <p class="feature__desc">50 minutes of expert instruction and feedback.</p>
        </div>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="container">
      <div class="footer__inner">
        <div class="footer__brand">
          <p class="footer__tagline">Private in-home lessons for all ages in Chicago's northwest suburbs.</p>
        </div>
        <div class="footer__contact">
          <a href="sms:8478408571" class="footer__contact-link">
            <span>Text</span>
            847-840-8571
          </a>
          <a href="mailto:northwest.lesson@gmail.com" class="footer__contact-link">
            <span>Email</span>
            northwest.lesson@gmail.com
          </a>
        </div>
      </div>
      <div class="footer__bottom">
        <span class="footer__copy">&copy; 2026 Northwest Piano &middot; Updated August 2026</span>
        <div class="footer__bottom-links">
          <a href="https://share.google/lvmWkYAiTzN25pvCe" target="_blank" rel="noopener">Google Reviews</a>
        </div>
      </div>
    </div>
  </footer>

  <script src="js/main.js"></script>
</body>
</html>
